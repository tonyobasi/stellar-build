NODE_ENV=production
PORT=3000
APP_HOST_PORT=3030
PUBLIC_BASE_URL=https://stellar.saference.com
TRUST_PROXY=true
REQUIRE_HTTPS=true
ALLOWED_HOSTS=stellar.saference.com
API_ALLOWED_IPS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# testnet or public
STELLAR_NETWORK=testnet
HORIZON_URL=
TRUSTED_HORIZON_URLS=https://horizon.stellar.org,https://horizon-testnet.stellar.org

TREASURY_SECRET=
API_KEY=
WALLET_ENCRYPTION_KEY=
WALLET_STARTING_XLM=3

USDC_ASSET_CODE=USDC
USDC_ISSUER=

APP_WEBHOOK_URL=
APP_WEBHOOK_SECRET=

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=stellar_usdc
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=stellar_usdc_wallet_service
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false

POLL_INTERVAL_MS=12000
WEBHOOK_INTERVAL_MS=10000
WEBHOOK_MAX_ATTEMPTS=12
