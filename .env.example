NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://stellar.saference.com
TRUST_PROXY=false
REQUIRE_HTTPS=false
ALLOWED_HOSTS=stellar.saference.com,localhost,127.0.0.1
API_ALLOWED_IPS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# testnet or public
STELLAR_NETWORK=testnet
# Optional override. Defaults to the right Horizon URL for STELLAR_NETWORK.
HORIZON_URL=
# Comma-separated allowlist. Keep custom Horizon URLs out of production unless you run/trust them.
TRUSTED_HORIZON_URLS=https://horizon.stellar.org,https://horizon-testnet.stellar.org

# Required. This treasury account funds generated accounts and pays fees.
# On testnet, create a random keypair and run: npm run fund:testnet -- <PUBLIC_KEY>
TREASURY_SECRET=

# Required. Shared secret for your app to call this service.
API_KEY=

# Required. Base64-encoded 32-byte key for encrypting generated wallet secrets.
# Generate with: openssl rand -base64 32
WALLET_ENCRYPTION_KEY=

# XLM sent to every generated wallet so it can hold its account reserve and USDC trustline reserve.
WALLET_STARTING_XLM=3

# Defaults are set automatically per network when these are empty.
USDC_ASSET_CODE=USDC
USDC_ISSUER=

# Your main app receives deposit.created events here.
APP_WEBHOOK_URL=
# Required when APP_WEBHOOK_URL is set. Generate with: openssl rand -hex 32
APP_WEBHOOK_SECRET=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=stellar_usdc
MYSQL_PASSWORD=
MYSQL_DATABASE=stellar_usdc_wallet_service
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false

POLL_INTERVAL_MS=12000
WEBHOOK_INTERVAL_MS=10000
WEBHOOK_MAX_ATTEMPTS=12
